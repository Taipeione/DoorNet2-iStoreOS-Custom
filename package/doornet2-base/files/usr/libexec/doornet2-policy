#!/bin/sh

set -eu

action=${1:-reconcile}

ensure_wechat_direct() {
	config=$1
	config_file="/etc/config/$config"
	[ -f "$config_file" ] || return 0

	uci -q get "$config.WeChatDirect" >/dev/null 2>&1 || \
		uci -q set "$config.WeChatDirect=shunt_rules"

	uci -q get "$config.WeChatDirect.remarks" >/dev/null 2>&1 || \
		uci -q set "$config.WeChatDirect.remarks=WeChatDirect"
	uci -q get "$config.WeChatDirect.network" >/dev/null 2>&1 || \
		uci -q set "$config.WeChatDirect.network=tcp,udp"
	uci -q get "$config.WeChatDirect.group" >/dev/null 2>&1 || \
		uci -q set "$config.WeChatDirect.group=CN"

	domains=$(uci -q get "$config.WeChatDirect.domain_list" 2>/dev/null || true)
	while IFS= read -r domain; do
		[ -n "$domain" ] || continue
		case "$domain" in \#*) continue ;; esac
		if ! printf '%s\n' "$domains" | grep -Fqx "$domain"; then
			if [ -n "$domains" ]; then
				domains=$(printf '%s\n%s' "$domains" "$domain")
			else
				domains=$domain
			fi
		fi
	done < /etc/doornet2/wechatdirect.domains
	uci -q set "$config.WeChatDirect.domain_list=$domains"

	# Link the rule to existing CN-group shunt nodes. Explicit user mappings
	# win; missing mappings are set to direct without touching other rules.
	uci -q show "$config" | while IFS= read -r entry; do
		case "$entry" in
			"$config".*.protocol="'_shunt'") node=${entry#"$config".}; node=${node%%.*} ;;
			*) continue ;;
		esac
		[ "$(uci -q get "$config.$node.shunt_group" 2>/dev/null || true)" = "CN" ] || continue
		uci -q get "$config.$node.WeChatDirect" >/dev/null 2>&1 || \
			uci -q set "$config.$node.WeChatDirect=_direct"
	done
	uci -q commit "$config"
}

case "$action" in
	reconcile)
		# Policy only: never start, stop, or enable PassWall, PassWall2, DNS
		# daemons, or any user-selected service. Their lifecycle belongs to the
		# corresponding package and remains untouched across upgrades.
		uci -q get doornet2.global >/dev/null 2>&1 || exit 0
		uci -q get doornet2.global.lan_ipv4 >/dev/null 2>&1 || \
			uci -q set doornet2.global.lan_ipv4='192.168.100.1'
		uci -q get doornet2.global.lan_netmask >/dev/null 2>&1 || \
			uci -q set doornet2.global.lan_netmask='255.255.255.0'
		uci -q get doornet2.global.passwall_default >/dev/null 2>&1 || \
			uci -q set doornet2.global.passwall_default='0'
		uci -q get doornet2.global.passwall2_default >/dev/null 2>&1 || \
			uci -q set doornet2.global.passwall2_default='0'
		uci -q get doornet2.global.wechat_direct >/dev/null 2>&1 || \
			uci -q set doornet2.global.wechat_direct='1'
		uci -q get doornet2.global.version >/dev/null 2>&1 || \
			uci -q set doornet2.global.version='DoorNet2-V0.1'
		uci -q commit doornet2
		[ "$(uci -q get doornet2.global.wechat_direct || true)" = "1" ] && {
			ensure_wechat_direct passwall
			ensure_wechat_direct passwall2
		}
		;;
	*)
		echo "usage: $0 reconcile" >&2
		exit 2
		;;
esac
