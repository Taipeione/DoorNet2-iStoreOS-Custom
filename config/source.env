# The signed upstream OpenWrt v25.12.5 tag resolves to this commit. This is
# deliberately a standard OpenWrt buildroot, not an iStoreOS fork.
OPENWRT_REPOSITORY=https://github.com/openwrt/openwrt.git
OPENWRT_VERSION=v25.12.5
OPENWRT_COMMIT=f0a60eee2fe051741c643ea6118718aae1ef17fb
OPENWRT_KERNEL=6.12.94

# iStore is an application feed, kept separate from the base system.
ISTORE_REPOSITORY=https://github.com/linkease/istore.git
ISTORE_COMMIT=a97ace34f2da358a015b094d326bba2697697f2e
