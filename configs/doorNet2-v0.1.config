CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_embedfire_doornet2=y

# DoorNet2 clean-install LAN. OTA keeps the existing UCI configuration.
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_TARGET_PREINIT_IP="192.168.100.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.100.255"

# Keep the firmware identity independent from the standard OpenWrt base release.
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="DoorNet2"
CONFIG_VERSION_NUMBER="V0.1"
CONFIG_VERSION_CODE="DoorNet2-V0.1"
CONFIG_VERSION_PRODUCT="DoorNet2-V0.1"

CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_u-boot-doornet2-rk3399=y
CONFIG_PACKAGE_doornet2-base=y
CONFIG_PACKAGE_trusted-firmware-a-rk3399=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall2=y
# PassWall2 selects dnsmasq-full. Do not also install the default dnsmasq
# variant; both packages own /usr/sbin/dnsmasq and related files.
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_chinadns-ng=y

# Debugger packages are not required in the firmware build.
# Keep the cross-toolchain lean and reproducible for V0.1.
# CONFIG_GDB is not set
